{
  "Environment": {
    "Name": "Development",
    "BaseUrl": "https://playwright.dev",
    "ApiBaseUrl": "https://playwright.dev"
  },
  "Browser": {
    "Type": "chromium",
    "Headless": true,
    "SlowMo": 0,
    "Viewport": {
      "Width": 1920,
      "Height": 1080
    }
  },
  "Timeouts": {
    "DefaultTimeout": 30000,
    "PageLoadTimeout": 30000,
    "NavigationTimeout": 30000,
    "FailureHoldTime": 5000
  },
  "TestData": {
    "Locale": "en",
    "DataDirectory": "TestData"
  },
  "Reporting": {
    "BaseDirectory": "TestResults",
    "Trace": {
      "Enabled": true,
      "Directory": "Traces",
      "Mode": "All",
      "Options": {
        "Screenshots": true,
        "Snapshots": true,
        "Sources": true,
        "Network": true,
        "SnapshotInterval": 100
      }
    },
    "Video": {
      "Enabled": true,
      "Directory": "Videos",
      "RetainOnFailure": true,
      "Size": {
        "Width": 1280,
        "Height": 720
      }
    },
    "Screenshots": {
      "Enabled": true,
      "Directory": "Screenshots",
      "TakeOnFailure": true,
      "Format": "png",
      "FullPage": true
    },
    "HtmlReport": {
      "Enabled": true,
      "Directory": "Report",
      "Title": "Test Execution Report",
      "Theme": "Standard",
      "EmbedScreenshots": true,
      "EmbedVideos": true,
      "EmbedTraces": true
    }
  }
}